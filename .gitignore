# secrets
cave-secret.json
*.token
.env
config/local.yaml

# data (lives outside the repo, junctioned in); anchored to the repo root so it
# doesn't also match viewer/public/data (the small exported viewer assets, which
# ARE tracked)
/data/
*.feather
*.parquet

# python
.venv/
__pycache__/
*.pyc
*.egg-info/
.pytest_cache/

# node / viewer
viewer/node_modules/
viewer/dist/

# logs, checkpoints, replays
/runs/
/checkpoints/
# raw match recordings live in C:\amongusfly-data; viewer/public/replays (small exports) IS tracked
/replays/
*.log

# OS
Thumbs.db
.DS_Store

# third-party reference screenshots (other creators' content): local only, never pushed
Untitled_Message/

# large replay exports: kept locally, not committed
/viewer/public/replays/trained_*/
/viewer/public/replays/showcase*/

# viewer recordings (attached to GitHub releases, too large for the repo)
/media/

# private working notes and plans, kept locally (not part of the public project)
/_private/
# app-specific local config (dev-server launch settings)
/.claude/
# regenerated diagnostic images
/docs/brain_panel_preview.png
/docs/results/*.png
